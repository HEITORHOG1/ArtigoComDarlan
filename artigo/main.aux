\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Schematic position of the two critical points of the cam profile of the AP 1.8 high-performance head: positive-acceleration peak ($a_{\max ,+}=14\,544$~m\,s$^{-2}$ at $L_{+}=6.04$~mm) and deceleration peak ($a_{\max ,-}=20\,362$~m\,s$^{-2}$ at $L_{-}=8.747$~mm). The full lift profile is generated from the cam sizing of the intake valve.}}{20}{figure.3}\protected@file@percent }
\newlabel{fig:lift}{{3}{20}{Schematic position of the two critical points of the cam profile of the AP 1.8 high-performance head: positive-acceleration peak ($a_{\max ,+}=14\,544$~m\,s$^{-2}$ at $L_{+}=6.04$~mm) and deceleration peak ($a_{\max ,-}=20\,362$~m\,s$^{-2}$ at $L_{-}=8.747$~mm). The full lift profile is generated from the cam sizing of the intake valve}{figure.3}{}}
