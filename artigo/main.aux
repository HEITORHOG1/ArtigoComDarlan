\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Spring natural frequencies $f_{n,\mathrm  {out}}$ and $f_{n,\mathrm  {in}}$ compared with the first six cam harmonics ($n=1,\dots  ,6$) across the engine-speed range up to 10\,000~rpm. The shaded region marks the operating regime; the dashed horizontal lines mark $f_{n,\mathrm  {out}}\approx 318$~Hz and $f_{n,\mathrm  {in}}\approx 571$~Hz.}}{21}{figure.4}\protected@file@percent }
\newlabel{fig:fn}{{4}{21}{Spring natural frequencies $f_{n,\mathrm {out}}$ and $f_{n,\mathrm {in}}$ compared with the first six cam harmonics ($n=1,\dots ,6$) across the engine-speed range up to 10\,000~rpm. The shaded region marks the operating regime; the dashed horizontal lines mark $f_{n,\mathrm {out}}\approx 318$~Hz and $f_{n,\mathrm {in}}\approx 571$~Hz}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Parametric sweep of the two speed-sensitive indicators across the engine-speed range 6\,000--12\,000~rpm for the AP 1.8 head at fixed geometry. The dynamic-ratio criterion is $R\geq 1.20$ and the surge-ratio rule-of-thumb is $f_{n}/f_{\mathrm  {cam}}\geq 4$. The intersection of the two pass criteria defines an analytical safe-operation envelope of approximately 6\,000--10\,500~rpm for the baseline configuration; barriers transition to at-risk above this band and the loss-of-contact boundary ($R\to 1$) is crossed near 11\,500~rpm.}}{21}{table.6}\protected@file@percent }
\newlabel{tbl:rpm-sweep}{{6}{21}{Parametric sweep of the two speed-sensitive indicators across the engine-speed range 6\,000--12\,000~rpm for the AP 1.8 head at fixed geometry. The dynamic-ratio criterion is $R\geq 1.20$ and the surge-ratio rule-of-thumb is $f_{n}/f_{\mathrm {cam}}\geq 4$. The intersection of the two pass criteria defines an analytical safe-operation envelope of approximately 6\,000--10\,500~rpm for the baseline configuration; barriers transition to at-risk above this band and the loss-of-contact boundary ($R\to 1$) is crossed near 11\,500~rpm}{table.6}{}}
